---
interface Props {
  title: string;
  intro?: string;
  mobilepayNumber?: string;
  bankRecipient?: string;
  bankIban?: string;
  bankMessage?: string;
  note?: string;
  thanks?: string;
}
const { title, intro, mobilepayNumber, bankRecipient, bankIban, bankMessage, note, thanks } = Astro.props;

/** Estää summien katkeamisen: ”6 000 €” → sitovat välilyönnit tuhaterottimeen ja ennen €-merkkiä. */
function keepAmountsTogether(text: string): string {
  return text.replace(/(\d) (?=\d{3}(?!\d))/g, '$1 ').replace(/(\d) €/g, '$1 €');
}

const mobilepay = mobilepayNumber?.trim();
const iban = bankIban?.trim();
const recipient = bankRecipient?.trim();
const message = bankMessage?.trim();
---
<section id="tue-kampanjaa" class="donation" aria-labelledby="tue-kampanjaa-otsikko">
  <div class="container-custom">
    <div class="donation-inner">
      <div class="donation-head">
        <h2 id="tue-kampanjaa-otsikko">{title}</h2>
        {intro && <p class="donation-intro">{keepAmountsTogether(intro)}</p>}
      </div>

      <div class="donation-cards">
        {mobilepay && (
          <div class="donation-card">
            <h3>MobilePay / Vipps</h3>
            <dl>
              <div class="donation-row">
                <dt>Numero</dt>
                <dd class="donation-value">
                  <span class="donation-number" data-copy-value>{mobilepay}</span>
                  <button type="button" class="copy-btn" data-copy={mobilepay.replace(/\s+/g, '')} data-copy-label="MobilePay-numero" aria-label="Kopioi MobilePay-numero" hidden>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
                    <span class="copy-btn-text">Kopioi</span>
                  </button>
                </dd>
              </div>
            </dl>
          </div>
        )}

        {iban && (
          <div class="donation-card">
            <h3>Tilisiirto</h3>
            <dl>
              {recipient && (
                <div class="donation-row">
                  <dt>Saaja</dt>
                  <dd>{recipient}</dd>
                </div>
              )}
              <div class="donation-row">
                <dt>Tilinumero</dt>
                <dd class="donation-value">
                  <span class="donation-iban" data-copy-value>{iban}</span>
                  <button type="button" class="copy-btn" data-copy={iban.replace(/\s+/g, '')} data-copy-label="Tilinumero" aria-label="Kopioi tilinumero" hidden>
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>
                    <span class="copy-btn-text">Kopioi</span>
                  </button>
                </dd>
              </div>
              {message && (
                <div class="donation-row">
                  <dt>Viesti</dt>
                  <dd>{message}</dd>
                </div>
              )}
            </dl>
          </div>
        )}
      </div>

      {note && <p class="donation-note">{keepAmountsTogether(note)}</p>}
      {thanks && <p class="donation-thanks">{keepAmountsTogether(thanks)}</p>}

      <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
    </div>
  </div>
</section>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  function announce(message: string) {
    if (!status) return;
    // Tyhjennys ensin, jotta sama viesti luetaan uudelleen toistuvalla kopioinnilla.
    status.textContent = '';
    requestAnimationFrame(() => { status.textContent = message; });
  }

  if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      btn.hidden = false;
      const text = btn.querySelector<HTMLElement>('.copy-btn-text');
      const label = btn.dataset.copyLabel ?? '';
      let timer: number | undefined;

      const showFor = (buttonText: string, ms: number) => {
        if (text) text.textContent = buttonText;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => { if (text) text.textContent = 'Kopioi'; }, ms);
      };

      btn.addEventListener('click', async () => {
        try {
          // Haetaan writeText klikkaushetkellä, ei etukäteen.
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          showFor('Kopioitu', 2000);
          announce(`${label} kopioitu`);
        } catch {
          // Kopiointi estetty: kerrotaan se ja valitaan arvo valmiiksi käsin kopioitavaksi.
          showFor('Ei onnistunut', 3000);
          announce(`${label}: kopiointi ei onnistunut. Valitse ja kopioi teksti itse.`);
          const value = btn.parentElement?.querySelector('[data-copy-value]');
          if (value) window.getSelection()?.selectAllChildren(value);
        }
      });
    });
  }
</script>

<style>
  .donation {
    background-color: var(--color-cream);
    padding: 0 0 4rem;
    scroll-margin-top: var(--header-h);
  }

  .donation-inner {
    max-width: 64rem;
    border-top: 1px solid rgba(13, 27, 42, 0.12);
    padding-top: 3rem;
  }

  .donation-head h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .donation-intro {
    color: var(--color-body-text);
    line-height: 1.75;
    max-width: 40rem;
  }

  .donation-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
    align-items: start;
  }

  .donation-card {
    background: var(--color-offwhite);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 1.25rem;
    padding: 1.5rem 1.25rem;
  }

  .donation-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .donation-row {
    padding: 0.75rem 0;
    border-top: 1px solid rgba(13, 27, 42, 0.08);
  }

  .donation-row dt {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-body-text);
    margin-bottom: 0.25rem;
  }

  .donation-row dd {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.4;
  }

  .donation-value {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
  }

  .donation-number {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .donation-iban {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid rgba(13, 27, 42, 0.15);
    border-radius: 9999px;
    background: transparent;
    color: var(--color-navy);
    font-family: var(--font-family-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .copy-btn[hidden] {
    display: none;
  }

  .copy-btn:hover {
    background-color: var(--color-green-brand);
    border-color: var(--color-green-brand);
    color: var(--color-offwhite);
  }

  .copy-btn:focus-visible {
    outline: 2px solid var(--color-green-brand);
    outline-offset: 2px;
  }

  .donation-note {
    margin-top: 2rem;
    max-width: 40rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-body-text);
  }

  .donation-thanks {
    margin-top: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy);
  }

  @media (min-width: 640px) {
    .donation-card {
      padding: 1.75rem;
    }
  }

  @media (min-width: 768px) {
    .donation-cards {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
